{
  "entities": {
    "User": {
      "title": "UserProfile",
      "description": "User account information and role assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["client", "vendor", "admin"] },
        "password": { "type": "string", "maxLength": 100 },
        "governorate": { "type": "string", "maxLength": 50 },
        "assignedServiceIds": { "type": "array" },
        "nationalIdFrontUrl": { "type": "string", "maxLength": 500 },
        "nationalIdBackUrl": { "type": "string", "maxLength": 500 },
        "clientTargetBudget": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Service": {
      "title": "Service",
      "description": "Wedding venue or vendor service listing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["hall", "photographer", "decor", "catering", "music", "makeup", "cafe_restaurant"] },
        "governorate": { "type": "string", "maxLength": 50 },
        "district": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "price": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "vendorId": { "type": "string", "maxLength": 128 },
        "vendorName": { "type": "string", "maxLength": 100 },
        "vendorPhone": { "type": "string", "maxLength": 30 },
        "availableDates": { "type": "array" },
        "bookedDates": { "type": "array" },
        "depositPercentage": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "title", "category", "governorate", "price", "vendorId"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Event booking request made by a client",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "serviceId": { "type": "string", "maxLength": 128 },
        "serviceName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 20 },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientPhone": { "type": "string", "maxLength": 30 },
        "clientEmail": { "type": "string", "maxLength": 150 },
        "clientId": { "type": "string", "maxLength": 128 },
        "totalPrice": { "type": "number" },
        "depositAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid_deposit", "fully_paid", "refunded", "pending"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "paid", "completed", "cancelled"] },
        "eventType": { "type": "string", "maxLength": 50 },
        "guestCount": { "type": "number" },
        "governorate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "serviceId", "clientName", "clientPhone", "totalPrice", "status", "paymentStatus"]
    },
    "VendorApplication": {
      "title": "VendorApplication",
      "description": "Application submitted by client to become a service provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userPhone": { "type": "string", "maxLength": 30 },
        "businessName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "governorate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "userName", "userEmail", "businessName", "category", "status"]
    },
    "Guest": {
      "title": "Guest",
      "description": "Event guest invitation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "companionsCount": { "type": "number" },
        "status": { "type": "string", "enum": ["accepted", "declined", "pending"] },
        "qrCode": { "type": "string", "maxLength": 200 },
        "checkedIn": { "type": "boolean" },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "name", "status"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Planning task checklist item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "completed": { "type": "boolean" },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "title", "completed"]
    },
    "BudgetItem": {
      "title": "BudgetItem",
      "description": "Event budget breakdown line item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "estimatedCost": { "type": "number" },
        "actualCost": { "type": "number" },
        "paidAmount": { "type": "number" },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientEmail": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "name", "estimatedCost"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Discount promo voucher code",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "discountPercentage": { "type": "number" },
        "validUntil": { "type": "string", "maxLength": 20 },
        "active": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "code", "discountPercentage", "active"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles storing role, credentials, and settings"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Service and hall venue listings managed by vendors and admins"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Event booking records linking clients to vendor services"
    },
    "/vendor_applications/{appId}": {
      "schema": { "$ref": "#/entities/VendorApplication" },
      "description": "Vendor partnership applications submitted for admin review"
    },
    "/guests/{guestId}": {
      "schema": { "$ref": "#/entities/Guest" },
      "description": "Guest list and QR invitation tracking for event organizers"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskItem" },
      "description": "Personal planning tasks for client event organizers"
    },
    "/budgets/{budgetItemId}": {
      "schema": { "$ref": "#/entities/BudgetItem" },
      "description": "Budget tracking line items"
    },
    "/promo_codes/{codeId}": {
      "schema": { "$ref": "#/entities/PromoCode" },
      "description": "Admin created promotional discount vouchers"
    },
    "/admins/{adminUid}": {
      "schema": { "type": "object" },
      "description": "System admin authorization lookup records"
    }
  }
}
